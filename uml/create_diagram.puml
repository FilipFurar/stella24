@startuml
start
:Open Stella24;
:Create a new table;

repeat
  if (What to add?) then (Attribute)
    repeat
      :Add a new attribute;
      :Choose attribute name;
      :Choose attribute data type;
      if (Can the attribute be NULL?) then (no)
        :Add the NOT NULL constraint to the attribute;
      else (yes)
      endif
      if (Is the attribute unique?) then (yes)
        :Add the Unique constraint to the attribute;
      else (no)
      endif
    repeat while (Need to add more?) is (yes)
  elseif (Foreign Key) then
    repeat
      :Add new foreign key;
      :Choose local attributes;
      :Choose referenced table;
      :Choose referenced attributes;
    repeat while (Need to add more?) is (yes)
  else (Constraint)
    repeat
      :Add new constraint;
      :Choose constraint type (PK, Unique, Check, etc.);
      :Choose affected attributes;
    repeat while (Need to add more?) is (yes)
  endif
repeat while (Need to add more?) is (yes)

stop
@enduml