@startuml
left to right direction
actor "User" as user
rectangle ER_Modeler {
    usecase "Save project as JSON" as save_project
    usecase "Load model from JSON" as load_model
    usecase "Export diagram to HTML" as export_html
    usecase "Export model to SQL" as export_sql
    usecase "Create new canvas" as new_canvas
    usecase "Quit application" as quit_app
}
user --> save_project
user --> load_model
user --> export_html
user --> export_sql
user --> new_canvas
user --> quit_app
@enduml