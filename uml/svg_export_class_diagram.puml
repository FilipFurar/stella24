@startuml

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "SVG Export" {
  struct AppStella {
	+to_svg(path: &str): void
	+to_svg_with_options(path: &str, options: SvgExportOptions, workbench_rects, default_dark_mode): void
	+svg_string_with_options(options: SvgExportOptions, workbench_rects, default_dark_mode): String
  }

  enum SvgLayoutMode {
	Automatic
	Workbench
  }

  enum SvgThemeChoice {
	Default
	Light
	Dark
  }

  struct SvgExportOptions {
	+layout: SvgLayoutMode
	+theme: SvgThemeChoice
  }

  struct SvgScene {
	+width: f32
	+height: f32
	+tables: Vec<SvgTableNode>
	+relations: Vec<SvgRelationEdge>
  }

  struct SvgTableNode {
	+id: TableId
	+title: String
	+attributes: Vec<SvgAttributeRow>
	+table_constraints: Vec<SvgTableConstraintRow>
	+rect: Rect
  }

  struct SvgAttributeRow {
	+name: String
	+datatype: String
	+constraints: String
  }

  struct SvgTableConstraintRow {
	+text: String
  }

  struct SvgRelationEdge {
	+from: Pos2
	+to: Pos2
	+route: Vec<Pos2>
	+from_cardinality: Cardinality
	+to_cardinality: Cardinality
	+kind: RelationshipKind
	+color: Color32
  }

  struct SvgExportPipeline <<utility>> {
	{static} model_to_svg_scene(app: AppStella): SvgScene
	{static} model_to_svg_scene_with_layout(app: AppStella, layout: SvgLayoutMode, workbench_rects): SvgScene
	{static} map_tables_to_nodes(tables, domains): Vec<SvgTableNode>
	{static} format_attribute_row(attr, domains): SvgAttributeRow
	{static} format_table_constraints(table, tables): Vec<SvgTableConstraintRow>
	{static} render_svg_scene(scene: SvgScene): String
	{static} render_relation(rel: SvgRelationEdge): Group
	{static} route_relation(from, to, rects): Vec<Pos2>
  }
}

AppStella --> SvgExportOptions : uses
AppStella --> SvgScene : builds
AppStella --> SvgExportPipeline : uses

SvgScene *-- "0..*" SvgTableNode : tables
SvgScene *-- "0..*" SvgRelationEdge : relations
SvgTableNode *-- "0..*" SvgAttributeRow : attributes
SvgTableNode *-- "0..*" SvgTableConstraintRow : table_constraints

SvgExportPipeline --> SvgScene
SvgExportPipeline --> SvgTableNode
SvgExportPipeline --> SvgAttributeRow
SvgExportPipeline --> SvgTableConstraintRow
SvgExportPipeline --> SvgRelationEdge


@enduml
